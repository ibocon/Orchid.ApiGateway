{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "clipboard-subpath-route": {
        "ClusterId": "clipboard-cluster",
        "Match": {
          "Path": "/orchid/api/clipboard/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orchid" }
        ]
      },
      "realtime-hub-subpath-route": {
        "ClusterId": "clipboard-cluster",
        "Match": {
          "Path": "/orchid/hubs/clipboard/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orchid" }
        ]
      },
      "clipboard-route": {
        "ClusterId": "clipboard-cluster",
        "Match": {
          "Path": "/api/clipboard/{**catch-all}"
        }
      },
      "realtime-hub-route": {
        "ClusterId": "clipboard-cluster",
        "Match": {
          "Path": "/hubs/clipboard/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "clipboard-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orchid-clipboard-service:8080"
          }
        }
      }
    }
  }
}